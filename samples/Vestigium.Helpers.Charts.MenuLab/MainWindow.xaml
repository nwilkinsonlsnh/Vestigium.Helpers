<Window x:Class="Vestigium.Helpers.Charts.MenuLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Charts Menu Lab"
        Width="1200" Height="760"
        Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock FontSize="18" FontWeight="SemiBold"
                 Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                 Text="Charts Menu Lab" />
      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                 Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}"
                 Text="Switch the real Vestigium palette, then right-click both plots. Left is ScottPlot's default Menu. Right is ChartView HostMenu." />

      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0"
                   Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                   Text="Theme" />
        <ComboBox x:Name="ThemeBox" Width="220"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="Id"
                  SelectionChanged="ThemeBox_SelectionChanged" />
        <CheckBox x:Name="ThemeTrap" Content="Force white MenuItem style"
                  Margin="16,0,0,0" VerticalAlignment="Center"
                  Checked="ThemeTrap_Changed" Unchecked="ThemeTrap_Changed" />
      </StackPanel>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8"
                   Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                   Text="Broken: default ScottPlot Menu" />
        <Border x:Name="BrokenHost" Background="{DynamicResource Vestigium.Brushes.Surface.Card}" />
      </DockPanel>

      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8"
                   Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                   Text="Fixed: ChartView HostMenu" />
        <Border x:Name="FixedHost" Background="{DynamicResource Vestigium.Brushes.Surface.Card}" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
