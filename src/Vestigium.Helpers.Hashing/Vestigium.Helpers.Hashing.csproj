<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Vestigium.Helpers.Hashing</RootNamespace>
    <AssemblyName>Vestigium.Helpers.Hashing</AssemblyName>
    <Description>String and file hashing (SHA-2, SHA-3, HMAC-SHA256/384/512, Argon2id, CRC-32/64, xxHash). Separate from Encryption.</Description>
    <Version>1.2.0</Version>
    <Authors>Vestigium</Authors>
    <Company>Wilkinson Business</Company>
    <PackageTags>hash;sha256;hmac;hmacsha384;hmacsha512;argon2id;crc32;xxhash;vestigium</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vestigium.Helpers\Vestigium.Helpers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
  </ItemGroup>
</Project>
