<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Vestigium.Helpers</RootNamespace>
    <AssemblyName>Vestigium.Helpers</AssemblyName>
    <Description>Core primitives shared by the Helpers libraries (guards, results, package metadata).</Description>
    <Version>1.0.0</Version>
    <Authors>Vestigium</Authors>
    <Company>Wilkinson Business</Company>
    <PackageTags>helpers;core;vestigium</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(VestigiumLoggingProject)">
      <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="_Documentation\Reports\" />
  </ItemGroup>
</Project>
