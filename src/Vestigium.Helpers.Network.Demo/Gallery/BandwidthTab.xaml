<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataTemplate x:Key="BandwidthTab">
    <StackPanel Margin="8">
      <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="Units are an enum. MB ≠ Mb. Windows: 1 day (86,400 s), 30-day month (2,592,000 s), 365-day year. Bots default to 0. P95 uses Analytics on samples you already have."/>
      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="120"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="120"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Size / page MB" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Grid.Column="1" Text="{Binding BwSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,8"/>
        <TextBlock Grid.Column="2" Text="Rate Mb/s" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Grid.Column="3" Text="{Binding BwRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Text="Human hits" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BwHuman, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="Googlebot hits" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding BwBots, UpdateSourceTrigger=PropertyChanged}"/>
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button Content="MB vs Mb" Command="{Binding ConvertBandwidthDemoCommand}"/>
        <Button Content="Day / 30-day / Year" Command="{Binding PeriodBandwidthDemoCommand}" Margin="8,0,0,0"/>
        <Button Content="Website" Command="{Binding WebsiteBandwidthDemoCommand}" Margin="8,0,0,0"/>
      </StackPanel>
      <TextBlock Margin="0,12,0,0" Text="{Binding BwSummary}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"/>
      <TextBlock Margin="0,16,0,4" Opacity="0.7" Text="P95 samples (Mb/s, comma-separated). Analytics computes the cut; Network converts Day / 30-day / Year."/>
      <TextBox Text="{Binding P95Samples, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Content="Bill P95" Command="{Binding BillP95DemoCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
      <TextBlock Margin="0,8,0,0" Text="{Binding P95Summary}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"/>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
