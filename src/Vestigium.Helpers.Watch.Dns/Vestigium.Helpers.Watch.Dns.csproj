<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RootNamespace>Vestigium.Helpers.Watch.Dns</RootNamespace>
		<AssemblyName>Vestigium.Helpers.Watch.Dns</AssemblyName>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>1.0.12</Version>
		<IsPackable>true</IsPackable>
		<PackageId>Vestigium.Helpers.Watch.Dns</PackageId>
		<IncludeBuildOutput>true</IncludeBuildOutput>
		<BuildOutputTargetFolder>tools</BuildOutputTargetFolder>
		<Authors>Vestigium</Authors>
		<Company>Wilkinson Business</Company>
		<Description>Elevated DNS watch. Windowless. Clock 5 to 180 seconds. No console.</Description>
		<PackageProjectUrl>https://github.com/nwilkinsonlsnh/Vestigium.Helpers</PackageProjectUrl>
		<RepositoryUrl>https://github.com/nwilkinsonlsnh/Vestigium.Helpers</RepositoryUrl>
	    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.15" />
	</ItemGroup>
	<ItemGroup>
		<None Include="build\Vestigium.Helpers.Watch.Dns.targets" Pack="true" PackagePath="build\Vestigium.Helpers.Watch.Dns.targets" />
		<None Include="build\Vestigium.Helpers.Watch.Dns.targets" Pack="true" PackagePath="buildTransitive\Vestigium.Helpers.Watch.Dns.targets" />
	</ItemGroup>
	<Target Name="PublishWatch" BeforeTargets="PackWatchExe" Condition="'$(RuntimeIdentifier)' == ''">
		<MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(IntermediateOutputPath)watch-publish\" />
	</Target>
	<Target Name="PackWatchExe" AfterTargets="_GetPackageFiles">
		<PropertyGroup>
			<_WatchToolFolder>tools/$(TargetFramework)$(TargetPlatformVersion)</_WatchToolFolder>
			<_WatchPublish>$(IntermediateOutputPath)watch-publish\</_WatchPublish>
			<_WatchSource Condition="Exists('$(_WatchPublish)$(AssemblyName).exe')">$(_WatchPublish)</_WatchSource>
			<_WatchSource Condition="'$(_WatchSource)' == ''">$(TargetDir)</_WatchSource>
		</PropertyGroup>
		<Error Text="Watch exe was not built at $(_WatchSource)$(AssemblyName).exe" Condition="!Exists('$(_WatchSource)$(AssemblyName).exe')" />
		<ItemGroup>
			<_WatchPacked Include="$(_WatchSource)$(AssemblyName).exe" />
			<_WatchPacked Include="$(_WatchSource)*.dll" />
			<_WatchPacked Include="$(_WatchSource)$(AssemblyName).runtimeconfig.json" />
			<_WatchPacked Include="$(_WatchSource)$(AssemblyName).deps.json" />
			<_WatchPacked>
				<PackagePath>$(_WatchToolFolder)/%(Filename)%(Extension)</PackagePath>
			</_WatchPacked>
			<_PackageFiles Include="@(_WatchPacked)" />
		</ItemGroup>
		<Message Importance="high" Text="Packing $(AssemblyName).exe and @(_WatchPacked->Count()) files into $(_WatchToolFolder)" />
	</Target>
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
