<Project>
  <Target Name="CopyVestigiumWatchDns" AfterTargets="Build">
    <ItemGroup>
      <_WatchDnsFiles Include="$(PkgVestigium_Helpers_Watch_Dns)\tools\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WatchDnsFiles)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="'@(_WatchDnsFiles)' != ''" />
  </Target>
</Project>
