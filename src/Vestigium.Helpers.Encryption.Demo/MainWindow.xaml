<Window x:Class="Vestigium.Helpers.Encryption.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vestigium.Helpers.Encryption gallery"
        Height="820" Width="1180"
        MinHeight="600" MinWidth="880"
        Background="#0B1A30" Foreground="#E2E8F0"
        FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="20,16,20,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel LastChildFill="False" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#7DD3FC" Text="VESTIGIUM SUITE"/>
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Vestigium.Helpers.Encryption gallery"/>
        <TextBlock Opacity="0.7" Text="AES-256-GCM · ChaCha20-Poly1305 · AES-256-CBC+HMAC · RSA key ring · Argon2id · 3/7-pass shred"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
        <TextBlock Opacity="0.9" FontFamily="Cascadia Mono, Consolas" FontSize="16" Text="{Binding WrittenCaption}" HorizontalAlignment="Right"/>
        <TextBlock Opacity="0.55" FontFamily="Cascadia Mono, Consolas" Text="AES-256-GCM · CBC+HMAC · RSA wrap · Argon2id · .aes / .argon" HorizontalAlignment="Right"/>
      </StackPanel>
    </DockPanel>
    <TabControl Grid.Row="1">
      <TabItem Header="Overview"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource OverviewTab}"/></TabItem>
      <TabItem Header="AES-256-GCM"><ContentControl Content="{Binding Gcm}" ContentTemplate="{StaticResource CipherTab}"/></TabItem>
      <TabItem Header="ChaCha20-Poly1305"><ContentControl Content="{Binding ChaCha}" ContentTemplate="{StaticResource CipherTab}"/></TabItem>
      <TabItem Header="AES-256-CBC + HMAC"><ContentControl Content="{Binding Cbc}" ContentTemplate="{StaticResource CipherTab}"/></TabItem>
      <TabItem Header="Argon2id"><ContentControl Content="{Binding Argon}" ContentTemplate="{StaticResource CipherTab}"/></TabItem>
      <TabItem Header="Key ring"><ContentControl Content="{Binding Rsa}" ContentTemplate="{StaticResource KeyRingTab}"/></TabItem>
      <TabItem Header="Round trip"><ContentControl Content="{Binding Rsa}" ContentTemplate="{StaticResource RoundTripTab}"/></TabItem>
      <TabItem Header="Validate"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ValidateTab}"/></TabItem>
      <TabItem Header="JSONL"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource JsonlTab}"/></TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock Opacity="0.55" Text="{Binding StatusText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</Window>
