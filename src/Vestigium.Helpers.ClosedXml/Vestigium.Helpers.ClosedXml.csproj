<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Vestigium.Helpers.ClosedXml</RootNamespace>
    <AssemblyName>Vestigium.Helpers.ClosedXml</AssemblyName>
    <Description>ClosedXML write-first Excel workbooks for Vestigium hosts.</Description>
    <Version>1.0.0</Version>
    <Authors>Vestigium</Authors>
    <Company>Wilkinson Business</Company>
    <PackageTags>excel;closedxml;xlsx;vestigium</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vestigium.Helpers.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vestigium.Helpers.Analytics\Vestigium.Helpers.Analytics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="EventCatalog\closedxml.json" Pack="true" PackagePath="contentFiles\any\any\EventCatalog\" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="_Documentation\" />
  </ItemGroup>
</Project>
