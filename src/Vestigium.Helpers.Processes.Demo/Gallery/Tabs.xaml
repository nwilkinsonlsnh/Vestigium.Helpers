<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <DataTemplate x:Key="ProcessesTab">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshProcessesCommand}" Style="{StaticResource PrimaryButton}"/>
        <ComboBox DockPanel.Dock="Right" Width="140" Margin="8,4,8,8"
                  ItemsSource="{Binding SearchModes}" SelectedItem="{Binding SearchMode}"/>
        <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"/>
      </DockPanel>
      <ListView Grid.Row="1" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding Pid}"/>
            <GridViewColumn Header="PPID" Width="70" DisplayMemberBinding="{Binding ParentPid}"/>
            <GridViewColumn Header="Name" Width="180" DisplayMemberBinding="{Binding Name}"/>
            <GridViewColumn Header="Session" Width="70" DisplayMemberBinding="{Binding SessionId}"/>
            <GridViewColumn Header="Private" Width="110" DisplayMemberBinding="{Binding PrivateBytes}"/>
            <GridViewColumn Header="Working set" Width="110" DisplayMemberBinding="{Binding WorkingSet}"/>
            <GridViewColumn Header="Image" Width="360" DisplayMemberBinding="{Binding ImagePath}"/>
          </GridView>
        </ListView.View>
      </ListView>
      <TextBlock Grid.Row="2" Margin="0,8,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12" Text="{Binding SelectedDetail}"/>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="WatchTab">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="PID" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Width="100" Text="{Binding WatchPid}"/>
        <Button Content="Start watch" Command="{Binding StartWatchCommand}" Style="{StaticResource PrimaryButton}"/>
        <Button Content="Stop" Command="{Binding StopWatchCommand}"/>
      </StackPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding WatchLines}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
               Background="#0A1628" Foreground="#E2E8F0" BorderThickness="0"/>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="ThreadsTab">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="PID" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Width="100" Text="{Binding ThreadPid}"/>
        <Button Content="List threads" Command="{Binding RefreshThreadsCommand}" Style="{StaticResource PrimaryButton}"/>
      </StackPanel>
      <ListView Grid.Row="1" ItemsSource="{Binding Threads}">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="TID" Width="80" DisplayMemberBinding="{Binding ThreadId}"/>
            <GridViewColumn Header="State" Width="120" DisplayMemberBinding="{Binding State}"/>
            <GridViewColumn Header="Start" Width="160" DisplayMemberBinding="{Binding StartAddress}"/>
            <GridViewColumn Header="Module" Width="180" DisplayMemberBinding="{Binding StartModule}"/>
            <GridViewColumn Header="Base pri" Width="80" DisplayMemberBinding="{Binding BasePriority}"/>
            <GridViewColumn Header="CSwitch" Width="90" DisplayMemberBinding="{Binding ContextSwitches}"/>
            <GridViewColumn Header="Cycles" Width="120" DisplayMemberBinding="{Binding Cycles}"/>
          </GridView>
        </ListView.View>
      </ListView>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="SystemTab">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button Content="Snapshot" Command="{Binding RefreshSystemCommand}" Style="{StaticResource PrimaryButton}"/>
        <Button Content="Watch system" Command="{Binding StartSystemWatchCommand}"/>
        <Button Content="Stop" Command="{Binding StopSystemWatchCommand}"/>
      </StackPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding SystemLines}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
               Background="#0A1628" Foreground="#E2E8F0" BorderThickness="0"/>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="LifetimeTab">
    <StackPanel>
      <TextBlock Style="{StaticResource Caption}" Text="Start file"/>
      <TextBox Text="{Binding StartFile}"/>
      <TextBlock Style="{StaticResource Caption}" Text="Arguments"/>
      <TextBox Text="{Binding StartArguments}"/>
      <StackPanel Orientation="Horizontal">
        <Button Content="Start" Command="{Binding StartProcessCommand}" Style="{StaticResource PrimaryButton}"/>
        <CheckBox Content="Confirm kill" IsChecked="{Binding ConfirmKill}" VerticalAlignment="Center"/>
        <Button Content="Kill selected / last started" Command="{Binding KillSelectedCommand}"/>
      </StackPanel>
      <TextBlock Margin="0,8,0,0" Text="{Binding LastStartedPid, StringFormat=Last started PID: {0}}"/>
      <TextBlock Opacity="0.6" Text="Protected names (lsass, csrss, …) return Denied. No taskkill."/>
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="CampaignTab">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0">
          <TextBlock Style="{StaticResource Caption}" Text="Campaign name"/>
          <TextBox Text="{Binding CampaignName}"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource Caption}" Text="Match term"/>
          <TextBox Text="{Binding CampaignTerm}"/>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="1" Orientation="Horizontal">
        <Button Content="Start 10-min window now" Command="{Binding StartCampaignCommand}" Style="{StaticResource PrimaryButton}"/>
        <Button Content="Stop" Command="{Binding StopCampaignCommand}"/>
        <TextBlock VerticalAlignment="Center" Margin="8,0,0,8" Text="{Binding CampaignState}"/>
      </StackPanel>
      <DockPanel Grid.Row="2">
        <TextBlock DockPanel.Dock="Top" Opacity="0.6" Text="{Binding CampaignPath}"/>
        <ListBox ItemsSource="{Binding CampaignLines}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 Background="#0A1628" Foreground="#E2E8F0" BorderThickness="0"/>
      </DockPanel>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
