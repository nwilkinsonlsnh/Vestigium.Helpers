<Window x:Class="Vestigium.Helpers.Processes.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vestigium.Helpers.Processes gallery"
        Height="860" Width="1280"
        MinHeight="640" MinWidth="960"
        Background="#0B1A30" Foreground="#E2E8F0"
        FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="20,16,20,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel LastChildFill="False" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#7DD3FC" Text="VESTIGIUM SUITE"/>
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Vestigium.Helpers.Processes gallery"/>
        <TextBlock Opacity="0.7" Text="List · search · watch · threads · system · start/kill · campaign JSONL"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
        <TextBlock Opacity="0.9" FontFamily="Cascadia Mono, Consolas" FontSize="16" Text="{Binding WrittenCaption}" HorizontalAlignment="Right"/>
        <TextBlock Opacity="0.55" FontFamily="Cascadia Mono, Consolas" Text="APPID Processes · no tasklist / taskkill" HorizontalAlignment="Right"/>
      </StackPanel>
    </DockPanel>
    <TabControl Grid.Row="1">
      <TabItem Header="Processes"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProcessesTab}"/></TabItem>
      <TabItem Header="Watch"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource WatchTab}"/></TabItem>
      <TabItem Header="Threads"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ThreadsTab}"/></TabItem>
      <TabItem Header="System"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource SystemTab}"/></TabItem>
      <TabItem Header="Start/Kill"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource LifetimeTab}"/></TabItem>
      <TabItem Header="Campaign"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource CampaignTab}"/></TabItem>
      <TabItem Header="JSONL"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource JsonlTab}"/></TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock Opacity="0.55" Text="{Binding StatusText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</Window>
