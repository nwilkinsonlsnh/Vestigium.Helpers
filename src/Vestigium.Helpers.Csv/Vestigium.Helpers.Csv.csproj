<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Vestigium.Helpers.Csv</RootNamespace>
    <AssemblyName>Vestigium.Helpers.Csv</AssemblyName>
    <Description>RFC 4180 CSV / TSV for Vestigium hosts. Separate from ClosedXml.</Description>
    <Version>1.0.0</Version>
    <Authors>Vestigium</Authors>
    <Company>Wilkinson Business</Company>
    <PackageTags>csv;tsv;rfc4180;vestigium</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vestigium.Helpers.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Vestigium.Logging" Version="1.7.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vestigium.Helpers.Analytics\Vestigium.Helpers.Analytics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="EventCatalog\csv.json" Pack="true" PackagePath="contentFiles\any\any\EventCatalog\" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
