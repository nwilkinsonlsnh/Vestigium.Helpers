<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Vestigium.Helpers.Pdf</RootNamespace>
    <AssemblyName>Vestigium.Helpers.Pdf</AssemblyName>
    <Description>Evidence PDFs. Report body, identity trailer, SHA-256 body hash, HMAC-SHA256 seal. Tamper-evident, not a certificate signature.</Description>
    <Version>1.3.0</Version>
    <Authors>Vestigium</Authors>
    <Company>Wilkinson Business</Company>
    <PackageTags>pdf;evidence;hmac;trailer;vestigium</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/nwilkinsonlsnh/Vestigium.Helpers</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nwilkinsonlsnh/Vestigium.Helpers</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vestigium.Helpers.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Vestigium.Helpers.Hashing" Version="1.4.1" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="README.md">
      <Pack>true</Pack>
      <PackagePath>\</PackagePath>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
