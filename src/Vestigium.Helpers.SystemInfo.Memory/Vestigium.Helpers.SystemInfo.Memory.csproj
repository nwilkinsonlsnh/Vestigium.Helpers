<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Vestigium.Helpers.SystemInfo.Memory</RootNamespace>
    <AssemblyName>Vestigium.Helpers.SystemInfo.Memory</AssemblyName>
    <Description>Physical and commit snapshot. Not a PDH sample.</Description>
    <Version>0.1.0</Version>
    <Authors>Vestigium</Authors>
    <Company>Wilkinson Business</Company>
    <PackageTags>systeminfo;memory;diagnostics;vestigium</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/nwilkinsonlsnh/Vestigium.Helpers</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nwilkinsonlsnh/Vestigium.Helpers</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vestigium.Helpers.SystemInfo\Vestigium.Helpers.SystemInfo.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="README.md">
      <Pack>true</Pack>
      <PackagePath>\</PackagePath>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
