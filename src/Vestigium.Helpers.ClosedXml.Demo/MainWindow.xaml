<Window x:Class="Vestigium.Helpers.ClosedXml.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vestigium.Helpers.ClosedXml gallery"
        Height="880" Width="1320"
        MinHeight="640" MinWidth="960"
        Background="#0B1A30" Foreground="#E2E8F0"
        FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="20,16,20,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel LastChildFill="False" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#7DD3FC" Text="VESTIGIUM SUITE"/>
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Vestigium.Helpers.ClosedXml gallery"/>
        <TextBlock Opacity="0.7" Text="Write-first Excel · tables, Table Design, charts, read-back, operator chrome"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
        <TextBlock Opacity="0.9" FontFamily="Cascadia Mono, Consolas" FontSize="16" Text="{Binding WrittenCaption}" HorizontalAlignment="Right"/>
        <TextBlock Opacity="0.55" FontFamily="Cascadia Mono, Consolas" Text="{Binding ChartCaption}" HorizontalAlignment="Right"/>
      </StackPanel>
    </DockPanel>
    <TabControl Grid.Row="1">
      <TabItem Header="Overview"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource OverviewTab}"/></TabItem>
      <TabItem Header="Write"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource WriteTab}"/></TabItem>
      <TabItem Header="Charts"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ChartsTab}"/></TabItem>
      <TabItem Header="Read"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ReadTab}"/></TabItem>
      <TabItem Header="Chrome"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ChromeTab}"/></TabItem>
      <TabItem Header="Inject"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource InjectTab}"/></TabItem>
      <TabItem Header="JSONL"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource JsonlTab}"/></TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock Opacity="0.55" Text="{Binding StatusText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</Window>
