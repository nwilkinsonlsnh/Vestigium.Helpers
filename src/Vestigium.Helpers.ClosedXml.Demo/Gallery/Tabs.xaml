<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="SwatchButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="3"/>
    <Setter Property="Margin" Value="3"/>
    <Setter Property="MinHeight" Value="52"/>
    <Setter Property="MinWidth" Value="52"/>
    <Setter Property="Background" Value="Transparent"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsSelected}" Value="True">
        <Setter Property="Background" Value="#1E4A7A"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <DataTemplate x:Key="OverviewTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Style="{StaticResource Id}" Text="VEST-HLP-CLOSEDXML  ·  write + charts"/>
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="What this module does"/>
        <TextBlock Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Write-first Excel. ClosedXML writes the tables; the helper splices native chart parts on save so Excel and LibreOffice render them. CSV is a sibling library, not a mode of this one."/>
        <WrapPanel>
          <Border Style="{StaticResource Card}" Width="280">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="SHEETS"/>
              <TextBlock FontWeight="SemiBold" Text="Six tabs"/>
              <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding SheetList}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Width="280">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="TABLE DESIGN"/>
              <TextBlock FontWeight="SemiBold" Text="{Binding ExcelStyleName}"/>
              <Border Margin="0,8,0,6" Width="88" Height="32" HorizontalAlignment="Left" CornerRadius="4" ClipToBounds="True">
                <StackPanel>
                  <Border Height="12" Background="{Binding PreviewHeader}"/>
                  <Border Height="10" Background="{Binding PreviewBand}"/>
                  <Border Height="10" Background="{Binding PreviewBandAlt}"/>
                </StackPanel>
              </Border>
              <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding SelectedStyleCaption}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Width="280">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="CHARTS"/>
              <TextBlock FontWeight="SemiBold" Text="{Binding ChartCaption}"/>
              <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="ClosedXML 0.105 cannot author charts. We inject OOXML after save."/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Width="280">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="EXPORT"/>
              <TextBlock FontWeight="SemiBold" Text="Desktop · Vestigium · Exports"/>
              <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding ExportFolder}"/>
            </StackPanel>
          </Border>
        </WrapPanel>
        <Border Style="{StaticResource Panel}" Margin="0,8,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="CALL"/>
            <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"
                       Text="{Binding StartupSnippet}"/>
            <WrapPanel Margin="0,12,0,0">
              <Button Content="Write workbook" Command="{Binding WriteWorkbookCommand}" Style="{StaticResource PrimaryButton}"/>
              <Button Content="Open export folder" Command="{Binding OpenExportFolderCommand}"/>
              <Button Content="Run probe" Command="{Binding RunProbeCommand}"/>
            </WrapPanel>
            <TextBlock Opacity="0.7" Text="{Binding ExportPath}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>

  <DataTemplate x:Key="WriteTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Style="{StaticResource Caption}" Text="TABLE DESIGN"/>
        <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Excel's Light / Medium / Dark gallery. Each chip is header + band + band-alt — pick by color. The workbook still writes Excel's built-in TableStyle name."/>
        <WrapPanel>
          <Button Content="Light" Command="{Binding SelectGroupCommand}" CommandParameter="Light">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="MinWidth" Value="88"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding StyleGroup}" Value="Light">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#0B1A30"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="Medium" Command="{Binding SelectGroupCommand}" CommandParameter="Medium">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="MinWidth" Value="88"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding StyleGroup}" Value="Medium">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#0B1A30"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="Dark" Command="{Binding SelectGroupCommand}" CommandParameter="Dark">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="MinWidth" Value="88"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding StyleGroup}" Value="Dark">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#0B1A30"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </WrapPanel>
        <ItemsControl Width="420" HorizontalAlignment="Left" ItemsSource="{Binding Swatches}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="7"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource SwatchButton}"
                      Command="{Binding DataContext.SelectStyleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding Id}"
                      ToolTip="{Binding ExcelName}"
                      AutomationProperties.Name="{Binding Caption}">
                <StackPanel>
                  <Border Height="28" CornerRadius="3" ClipToBounds="True">
                    <StackPanel>
                      <Border Height="10" Background="{Binding Header}"/>
                      <Border Height="9" Background="{Binding Band}"/>
                      <Border Height="9" Background="{Binding BandAlt}"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Margin="0,4,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="10"
                             Opacity="0.7" HorizontalAlignment="Center" Text="{Binding Index}"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Margin="0,4,0,8" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                   Text="{Binding SelectedStyleCaption}"/>

        <TextBlock Style="{StaticResource Caption}" Text="LIVE SAMPLE"/>
        <Border Width="360" HorizontalAlignment="Left" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,12">
          <StackPanel>
            <Grid Background="{Binding PreviewHeader}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Padding="10,8" FontWeight="SemiBold" Foreground="{Binding PreviewHeaderInk}" Text="Band"/>
              <TextBlock Grid.Column="1" Padding="10,8" FontWeight="SemiBold" Foreground="{Binding PreviewHeaderInk}" Text="n"/>
              <TextBlock Grid.Column="2" Padding="10,8" FontWeight="SemiBold" Foreground="{Binding PreviewHeaderInk}" Text="P50"/>
            </Grid>
            <Grid Background="{Binding PreviewBand}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Padding="10,7" Foreground="{Binding PreviewBodyInk}" Text="Q1"/>
              <TextBlock Grid.Column="1" Padding="10,7" Foreground="{Binding PreviewBodyInk}" Text="250"/>
              <TextBlock Grid.Column="2" Padding="10,7" Foreground="{Binding PreviewBodyInk}" Text="12.1"/>
            </Grid>
            <Grid Background="{Binding PreviewBandAlt}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Padding="10,7" Foreground="{Binding PreviewBodyInk}" Text="IQR"/>
              <TextBlock Grid.Column="1" Padding="10,7" Foreground="{Binding PreviewBodyInk}" Text="500"/>
              <TextBlock Grid.Column="2" Padding="10,7" Foreground="{Binding PreviewBodyInk}" Text="18.4"/>
            </Grid>
            <Grid Background="{Binding PreviewBand}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Padding="10,7" Foreground="{Binding PreviewBodyInk}" Text="Q4"/>
              <TextBlock Grid.Column="1" Padding="10,7" Foreground="{Binding PreviewBodyInk}" Text="250"/>
              <TextBlock Grid.Column="2" Padding="10,7" Foreground="{Binding PreviewBodyInk}" Text="40.2"/>
            </Grid>
          </StackPanel>
        </Border>

        <CheckBox Content="Include Excel charts" IsChecked="{Binding IncludeCharts}"/>
        <WrapPanel Margin="0,8,0,0">
          <Button Content="Draw new sample" Command="{Binding DrawSampleCommand}"/>
          <Button Content="Write workbook" Command="{Binding WriteWorkbookCommand}" Style="{StaticResource PrimaryButton}"/>
          <Button Content="Open export folder" Command="{Binding OpenExportFolderCommand}"/>
        </WrapPanel>
        <WrapPanel>
          <Border Style="{StaticResource Card}" Width="220">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="n"/>
              <TextBlock FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" Text="{Binding Count, StringFormat=N0}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Width="220">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="MEAN"/>
              <TextBlock FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" Text="{Binding MeanText}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Width="220">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="P95"/>
              <TextBlock FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" Text="{Binding P95Text}"/>
            </StackPanel>
          </Border>
        </WrapPanel>
        <TextBlock Style="{StaticResource Caption}" Text="SHEETS IN THE LAST WORKBOOK"/>
        <TextBlock FontFamily="Cascadia Mono, Consolas" Text="{Binding SheetList}"/>
        <TextBlock Style="{StaticResource Caption}" Text="PATH"/>
        <TextBlock FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" Text="{Binding ExportPath}"/>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>

  <DataTemplate x:Key="ChartsTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Preview of the four series that land as native Excel charts. The downloaded workbook is the source of truth."/>
        <TextBlock Style="{StaticResource Caption}" Text="HISTOGRAM"/>
        <ItemsControl Height="160" ItemsSource="{Binding Histogram}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="2,0" VerticalAlignment="Bottom" Height="{Binding Height}" Background="#4C6B8A" ToolTip="{Binding Caption}" CornerRadius="2,2,0,0"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource Caption}" Text="BAND MEANS"/>
        <ListView Height="180" ItemsSource="{Binding Bands}" FontFamily="Cascadia Mono, Consolas" FontSize="12">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Band" Width="80" DisplayMemberBinding="{Binding Band}"/>
              <GridViewColumn Header="n" Width="70" DisplayMemberBinding="{Binding N}"/>
              <GridViewColumn Header="Mean" Width="120" DisplayMemberBinding="{Binding Mean}"/>
              <GridViewColumn Header="P50" Width="120" DisplayMemberBinding="{Binding P50}"/>
            </GridView>
          </ListView.View>
        </ListView>
        <TextBlock Style="{StaticResource Caption}" Text="MEAN CONFIDENCE"/>
        <ListView Height="180" ItemsSource="{Binding Intervals}" FontFamily="Cascadia Mono, Consolas" FontSize="12">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Level" Width="90" DisplayMemberBinding="{Binding Level}"/>
              <GridViewColumn Header="Estimate" Width="110" DisplayMemberBinding="{Binding Estimate}"/>
              <GridViewColumn Header="Lower" Width="110" DisplayMemberBinding="{Binding Lower}"/>
              <GridViewColumn Header="Upper" Width="110" DisplayMemberBinding="{Binding Upper}"/>
              <GridViewColumn Header="Method" Width="220" DisplayMemberBinding="{Binding Method}"/>
            </GridView>
          </ListView.View>
        </ListView>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>

  <DataTemplate x:Key="InjectTab">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="Strings that start with = + - @ are stored with a leading apostrophe. The library never evaluates caller formulas."/>
      <ListView Grid.Row="1" ItemsSource="{Binding Injection}" FontFamily="Cascadia Mono, Consolas" FontSize="12">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Payload" Width="220" DisplayMemberBinding="{Binding Key}"/>
            <GridViewColumn Header="Stored" Width="220" DisplayMemberBinding="{Binding Value}"/>
          </GridView>
        </ListView.View>
      </ListView>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
