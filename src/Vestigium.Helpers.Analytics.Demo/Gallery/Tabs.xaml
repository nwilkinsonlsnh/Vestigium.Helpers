<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataTemplate x:Key="OverviewTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Style="{StaticResource Id}" Text="VEST-HLP-ANL  ·  SRS v1.2"/>
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="What this module does"/>
        <TextBlock Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="NumericSeries is an immutable snapshot of a finite sample. It publishes the five-number summary, quartile bands, PERCENTILE.INC tails, and frequentist intervals. Charting stays out of this library — the gallery draws the numbers so you can see them."/>
        <WrapPanel>
          <Border Style="{StaticResource Card}" Width="280">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="SAMPLE"/>
              <TextBlock FontWeight="SemiBold" Text="{Binding Name}"/>
              <TextBlock Opacity="0.7" Text="{Binding Count, StringFormat='n = {0:N0} unique integers'}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Width="280">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="FIVE-NUMBER"/>
              <TextBlock FontWeight="SemiBold" Text="{Binding FiveNumber}"/>
              <TextBlock Opacity="0.7" Text="min / Q1 / median / Q3 / max"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Width="280">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="MEAN 95% CI"/>
              <TextBlock FontWeight="SemiBold" Text="{Binding MeanCiText}"/>
              <TextBlock Opacity="0.7" Text="t interval · not P95"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Width="280">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="P95"/>
              <TextBlock FontWeight="SemiBold" Text="{Binding P95Text}"/>
              <TextBlock Opacity="0.7" Text="PERCENTILE.INC cutoff — not confidence"/>
            </StackPanel>
          </Border>
        </WrapPanel>
        <Border Style="{StaticResource Panel}" Margin="0,8,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="CALL"/>
            <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"
                       Text="{Binding StartupSnippet}"/>
            <TextBlock Opacity="0.7" Margin="0,8,0,0" Text="{Binding InferenceText}"/>
            <WrapPanel Margin="0,12,0,0">
              <Button Content="Draw new sample" Command="{Binding DrawSampleCommand}" Style="{StaticResource PrimaryButton}"/>
              <Button Content="Run probe" Command="{Binding RunProbeCommand}"/>
              <Button Content="Copy log directory" Command="{Binding CopyLogDirectoryCommand}"/>
            </WrapPanel>
            <TextBlock Opacity="0.55" Text="{Binding LogDirectoryCaption}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>

  <DataTemplate x:Key="SampleTab">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <DockPanel LastChildFill="False" Margin="0,0,0,8">
        <TextBlock FontWeight="SemiBold" Text="First 80 observations" VerticalAlignment="Center"/>
        <Button DockPanel.Dock="Right" Content="Draw new sample" Command="{Binding DrawSampleCommand}" Style="{StaticResource PrimaryButton}"/>
      </DockPanel>
      <ListView Grid.Row="1" ItemsSource="{Binding Sample}" FontFamily="Cascadia Mono, Consolas" FontSize="12">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Index" Width="80" DisplayMemberBinding="{Binding Index}"/>
            <GridViewColumn Header="Value" Width="160" DisplayMemberBinding="{Binding Value}"/>
            <GridViewColumn Header="Timestamp" Width="140" DisplayMemberBinding="{Binding Timestamp}"/>
          </GridView>
        </ListView.View>
      </ListView>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="SummaryTab">
    <ListView ItemsSource="{Binding Summary}" FontFamily="Cascadia Mono, Consolas" FontSize="12">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Metric" Width="220" DisplayMemberBinding="{Binding Key}"/>
          <GridViewColumn Header="Value" Width="280" DisplayMemberBinding="{Binding Value}"/>
        </GridView>
      </ListView.View>
    </ListView>
  </DataTemplate>

  <DataTemplate x:Key="BandsTab">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="Q1 is the left tail of the sample. Q4 is the right tail — the slow RTTs. IQR is the middle 50%."/>
      <ListView Grid.Row="1" ItemsSource="{Binding Bands}" FontFamily="Cascadia Mono, Consolas" FontSize="12">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Band" Width="70" DisplayMemberBinding="{Binding Band}"/>
            <GridViewColumn Header="n" Width="70" DisplayMemberBinding="{Binding N}"/>
            <GridViewColumn Header="Min" Width="110" DisplayMemberBinding="{Binding Min}"/>
            <GridViewColumn Header="P50" Width="110" DisplayMemberBinding="{Binding P50}"/>
            <GridViewColumn Header="Max" Width="110" DisplayMemberBinding="{Binding Max}"/>
            <GridViewColumn Header="Mean" Width="110" DisplayMemberBinding="{Binding Mean}"/>
            <GridViewColumn Header="StdDev" Width="110" DisplayMemberBinding="{Binding StdDev}"/>
            <GridViewColumn Header="Skew" Width="90" DisplayMemberBinding="{Binding Skew}"/>
            <GridViewColumn Header="ExKurt" Width="90" DisplayMemberBinding="{Binding ExKurt}"/>
          </GridView>
        </ListView.View>
      </ListView>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="HistogramTab">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="180"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="Freedman–Diaconis bins on the value axis. Time is not an axis of this histogram."/>
      <ItemsControl Grid.Row="1" ItemsSource="{Binding Histogram}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="2,0" VerticalAlignment="Bottom" Height="{Binding Height}" Background="#4C6B8A" ToolTip="{Binding Caption}" CornerRadius="2,2,0,0"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ListView Grid.Row="2" Margin="0,12,0,0" ItemsSource="{Binding Histogram}" FontFamily="Cascadia Mono, Consolas" FontSize="12">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Lower" Width="140" DisplayMemberBinding="{Binding Label}"/>
            <GridViewColumn Header="Count" Width="100" DisplayMemberBinding="{Binding Count}"/>
            <GridViewColumn Header="Bin" Width="160" DisplayMemberBinding="{Binding Caption}"/>
          </GridView>
        </ListView.View>
      </ListView>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="ChartsTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <DockPanel LastChildFill="False" Margin="0,0,0,8">
          <TextBlock FontWeight="SemiBold" Text="Curves from NumericSeries" VerticalAlignment="Center"/>
          <Button DockPanel.Dock="Right" Content="Draw new sample" Command="{Binding DrawSampleCommand}" Style="{StaticResource PrimaryButton}"/>
        </DockPanel>
        <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Charting stays out of the library. This tab draws EcdfPoints() and SampleOrderPoints(). Y on the ECDF is the share of the sample at or below X. The dashed line is P95 — a rank cutoff, not 95% confidence."/>
        <TextBlock Style="{StaticResource Caption}" Text="ECDF"/>
        <Border Style="{StaticResource Panel}" Height="300" Margin="0,0,0,8">
          <DockPanel>
            <DockPanel DockPanel.Dock="Bottom" LastChildFill="True" Margin="0,6,0,0">
              <TextBlock DockPanel.Dock="Left" FontFamily="Cascadia Mono, Consolas" FontSize="11" Opacity="0.7" Text="{Binding EcdfMinLabel}"/>
              <TextBlock DockPanel.Dock="Right" FontFamily="Cascadia Mono, Consolas" FontSize="11" Opacity="0.7" Text="{Binding EcdfMaxLabel}"/>
              <TextBlock HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#7DD3FC" Text="{Binding EcdfP95Label}"/>
            </DockPanel>
            <Viewbox Stretch="Fill">
              <Canvas Width="720" Height="240">
                <Line X1="12" Y1="228" X2="708" Y2="228" Stroke="#2A4A73" StrokeThickness="1"/>
                <Line X1="12" Y1="12" X2="12" Y2="228" Stroke="#2A4A73" StrokeThickness="1"/>
                <Line X1="{Binding P95LineX}" Y1="12" X2="{Binding P95LineX}" Y2="228"
                      Stroke="#E2E8F0" StrokeThickness="1" StrokeDashArray="4 3"/>
                <Polyline Points="{Binding EcdfCurve}" Stroke="#7DD3FC" StrokeThickness="2.5"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
              </Canvas>
            </Viewbox>
          </DockPanel>
        </Border>
        <TextBlock Style="{StaticResource Caption}" Text="SAMPLE ORDER"/>
        <Border Style="{StaticResource Panel}" Height="260">
          <DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Opacity="0.7" Margin="0,6,0,0"
                       Text="Observation index → value. Same points as the Sample tab, in draw order."/>
            <Viewbox Stretch="Fill">
              <Canvas Width="720" Height="240">
                <Line X1="12" Y1="228" X2="708" Y2="228" Stroke="#2A4A73" StrokeThickness="1"/>
                <Line X1="12" Y1="12" X2="12" Y2="228" Stroke="#2A4A73" StrokeThickness="1"/>
                <Polyline Points="{Binding SampleCurve}" Stroke="#5B9BD5" StrokeThickness="1.6"
                          StrokeLineJoin="Round" Fill="Transparent"/>
              </Canvas>
            </Viewbox>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>

  <DataTemplate x:Key="ConfidenceTab">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="A confidence level is an input. P90 / P95 / P99 on the Summary tab are rank cutoffs, not 90/95/99% confidence that a parameter sits in an interval."/>
      <ListView Grid.Row="1" ItemsSource="{Binding Intervals}" FontFamily="Cascadia Mono, Consolas" FontSize="12">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Level" Width="90" DisplayMemberBinding="{Binding Level}"/>
            <GridViewColumn Header="Parameter" Width="110" DisplayMemberBinding="{Binding Parameter}"/>
            <GridViewColumn Header="Estimate" Width="110" DisplayMemberBinding="{Binding Estimate}"/>
            <GridViewColumn Header="Lower" Width="110" DisplayMemberBinding="{Binding Lower}"/>
            <GridViewColumn Header="Upper" Width="110" DisplayMemberBinding="{Binding Upper}"/>
            <GridViewColumn Header="Width" Width="110" DisplayMemberBinding="{Binding Width}"/>
            <GridViewColumn Header="Method" Width="220" DisplayMemberBinding="{Binding Method}"/>
            <GridViewColumn Header="Defined" Width="80" DisplayMemberBinding="{Binding Defined}"/>
          </GridView>
        </ListView.View>
      </ListView>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
