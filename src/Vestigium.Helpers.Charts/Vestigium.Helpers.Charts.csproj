<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Vestigium.Helpers.Charts</RootNamespace>
    <AssemblyName>Vestigium.Helpers.Charts</AssemblyName>
    <Description>ScottPlot wrapper that puts Analytics numbers on a WPF form.</Description>
    <Version>1.0.0</Version>
    <Authors>Vestigium</Authors>
    <Company>Wilkinson Business</Company>
    <PackageTags>charts;scottplot;wpf;vestigium</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;NU1701</NoWarn>
    <IsPackable>true</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vestigium.Helpers.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ScottPlot.WPF" Version="5.1.57" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vestigium.Helpers\Vestigium.Helpers.csproj" />
    <ProjectReference Include="..\Vestigium.Helpers.Analytics\Vestigium.Helpers.Analytics.csproj" />
    <ProjectReference Include="$(VestigiumLoggingProject)" />
  </ItemGroup>
</Project>
