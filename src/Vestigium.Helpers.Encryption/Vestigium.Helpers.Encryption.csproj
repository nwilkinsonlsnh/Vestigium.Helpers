<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Vestigium.Helpers.Encryption</RootNamespace>
    <AssemblyName>Vestigium.Helpers.Encryption</AssemblyName>
    <Description>Authenticated encryption helpers (AES-256-GCM, ChaCha20-Poly1305, AES-256-CBC+HMAC, RSA-OAEP wrap, Argon2id, trailer SHA-256 / caller HMAC). Separate from Hashing.</Description>
    <Version>1.3.0</Version>
    <Authors>Vestigium</Authors>
    <Company>Wilkinson Business</Company>
    <PackageTags>encryption;aes-gcm;chacha20;argon2;hmac;sha256;vestigium</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vestigium.Helpers\Vestigium.Helpers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>
</Project>
