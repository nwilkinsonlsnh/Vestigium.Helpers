<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataTemplate x:Key="OverviewTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Style="{StaticResource Id}" Text="VEST-HLP-XML  ·  SRS v1.0"/>
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="What this module does"/>
        <TextBlock FontFamily="Cascadia Mono, Consolas" Opacity="0.7" Text="{Binding Identity}"/>
        <TextBlock Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Payload XML: settings, OMA DDF, UPnP SCPD, Windows RE, diagnostic dumps you need to query. Platform parser only (XmlReader + XDocument). RFC 7303 encoding. XPath 1.0 plus local-name search. An edit session so you can see the change list before disk changes. Not FileIo. Not Json. Not a DDF SDK."/>
        <WrapPanel>
          <Border Style="{StaticResource Card}" Width="260">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="ENCODING"/>
              <TextBlock FontWeight="SemiBold" Text="RFC 7303"/>
              <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="BOM, then charset, then declaration, then UTF-8. text/xml is an alias of application/xml."/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Width="260">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="SESSION"/>
              <TextBlock FontWeight="SemiBold" Text="Snapshot → Diff → Commit"/>
              <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="Set mutates working memory. Save writes committed. Cancel leaves disk alone."/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Width="260">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="SAFE LOAD"/>
              <TextBlock FontWeight="SemiBold" Text="DTD ignored · resolver 0"/>
              <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="PUBLIC DOCTYPE is captured, never fetched. Undeclared entities are dropped."/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Width="260">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="EXPORT"/>
              <TextBlock FontWeight="SemiBold" Text="Desktop · Vestigium · Exports · Xml"/>
              <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding ExportFolder}"/>
            </StackPanel>
          </Border>
        </WrapPanel>
        <Border Style="{StaticResource Panel}" Margin="0,8,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="CALL"/>
            <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"
                       Text="{Binding StartupSnippet}"/>
            <WrapPanel Margin="0,12,0,0">
              <Button Content="Seed demo files" Command="{Binding SeedDemoCommand}" Style="{StaticResource PrimaryButton}"/>
              <Button Content="Open export folder" Command="{Binding OpenExportFolderCommand}"/>
              <Button Content="Run probe" Command="{Binding RunProbeCommand}"/>
            </WrapPanel>
            <TextBlock Opacity="0.7" Text="{Binding DocumentPath}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>

  <DataTemplate x:Key="DocumentTab">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0">
        <TextBlock Style="{StaticResource Caption}" Text="WORKING COPY"/>
        <TextBlock Text="{Binding DocumentPath}" TextWrapping="Wrap" Opacity="0.75"/>
        <TextBlock Style="{StaticResource Caption}" Text="XPATH"/>
        <TextBox Text="{Binding EditPath, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Style="{StaticResource Caption}" Text="SET TEXT"/>
        <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"/>
        <WrapPanel>
          <Button Content="Load" Command="{Binding LoadDocumentCommand}"/>
          <Button Content="Snapshot + Set" Command="{Binding ApplyEditCommand}" Style="{StaticResource PrimaryButton}"/>
          <Button Content="Commit" Command="{Binding CommitDocumentCommand}"/>
          <Button Content="Save" Command="{Binding SaveDocumentCommand}"/>
          <Button Content="Cancel" Command="{Binding CancelDocumentCommand}"/>
        </WrapPanel>
        <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding DocumentCaption}"/>
      </StackPanel>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Panel}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="DIFF (ops, never values in HelperLog)"/>
            <TextBox IsReadOnly="True" Text="{Binding DiffText}" FontFamily="Cascadia Mono, Consolas"
                     FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,8,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="WORKING XML (memory · Save writes committed)"/>
            <TextBox IsReadOnly="True" Text="{Binding WorkingXml}" FontFamily="Cascadia Mono, Consolas"
                     FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" AcceptsReturn="True"/>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="SearchTab">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0">
        <TextBlock Style="{StaticResource Caption}" Text="FILE"/>
        <TextBlock Text="{Binding SearchPath}" TextWrapping="Wrap" Opacity="0.75"/>
        <TextBlock Style="{StaticResource Caption}" Text="KIND"/>
        <ComboBox SelectedValue="{Binding QueryKind}" SelectedValuePath="Content">
          <ComboBoxItem Content="xpath"/>
          <ComboBoxItem Content="name"/>
          <ComboBoxItem Content="attribute"/>
          <ComboBoxItem Content="text"/>
        </ComboBox>
        <TextBlock Style="{StaticResource Caption}" Text="QUERY"/>
        <TextBox Text="{Binding QueryValue, UpdateSourceTrigger=PropertyChanged}"/>
        <WrapPanel>
          <Button Content="osinfo MagicOn" Command="{Binding SearchMagicOnCommand}"/>
          <Button Content="ipcfg actions" Command="{Binding SearchActionsCommand}"/>
          <Button Content="Search" Command="{Binding RunSearchCommand}" Style="{StaticResource PrimaryButton}"/>
        </WrapPanel>
        <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding SearchCaption}"/>
      </StackPanel>
      <Border Grid.Column="1" Style="{StaticResource Panel}">
        <ListView ItemsSource="{Binding SearchHits}">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="path" DisplayMemberBinding="{Binding NodePath}" Width="320"/>
              <GridViewColumn Header="name" DisplayMemberBinding="{Binding LocalName}" Width="120"/>
              <GridViewColumn Header="text" DisplayMemberBinding="{Binding Text}" Width="200"/>
            </GridView>
          </ListView.View>
        </ListView>
      </Border>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="MultiTab">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0">
        <TextBlock Style="{StaticResource Caption}" Text="CONCATENATED STREAM"/>
        <TextBlock Text="{Binding MultiPath}" TextWrapping="Wrap" Opacity="0.75"/>
        <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="Open of this file is Failed. OpenMulti is the path. v1 is read/search only."/>
        <TextBlock Style="{StaticResource Caption}" Text="ATTRIBUTE"/>
        <TextBox Text="{Binding MultiQuery, UpdateSourceTrigger=PropertyChanged}"/>
        <WrapPanel>
          <Button Content="OpenMulti" Command="{Binding OpenMultiCommand}" Style="{StaticResource PrimaryButton}"/>
          <Button Content="Scan" Command="{Binding ScanMultiCommand}"/>
        </WrapPanel>
        <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding MultiCaption}"/>
      </StackPanel>
      <Border Grid.Column="1" Style="{StaticResource Panel}">
        <ListView ItemsSource="{Binding MultiHits}">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="#" DisplayMemberBinding="{Binding Part}" Width="48"/>
              <GridViewColumn Header="path" DisplayMemberBinding="{Binding NodePath}" Width="280"/>
              <GridViewColumn Header="name" DisplayMemberBinding="{Binding LocalName}" Width="140"/>
            </GridView>
          </ListView.View>
        </ListView>
      </Border>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="SafetyTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Style="{StaticResource Id}" Text="DTD · XXE · SIZE CAP"/>
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Safe load"/>
        <TextBlock Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="DevicePreparationDDF.xml carries a PUBLIC DOCTYPE to a remote OMA DTD. The helper captures the text and never asks a resolver. Try XXE writes a local entity payload and Open must not expand it."/>
        <WrapPanel>
          <Button Content="Open DDF" Command="{Binding OpenDdfCommand}" Style="{StaticResource PrimaryButton}"/>
          <Button Content="Try XXE" Command="{Binding TryXxeCommand}"/>
        </WrapPanel>
        <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
          <TextBox IsReadOnly="True" Text="{Binding SafetyText}" FontFamily="Cascadia Mono, Consolas"
                   FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="180"/>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>

  <DataTemplate x:Key="ExportTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Style="{StaticResource Id}" Text="Desktop\Vestigium\Exports\Xml"/>
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Export folder"/>
        <TextBlock Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Default dest when the host omits a directory. Tests inject XmlTestHooks.ExportRoot and never touch the real Desktop. Probe stays in memory. Collision default Fail — there is no UniqueName here. Gold fixtures seed Documents\Xml from Content."/>
        <Border Style="{StaticResource Panel}">
          <StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="FOLDER"/>
            <TextBlock FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" Text="{Binding ExportFolder}"/>
            <TextBlock Style="{StaticResource Caption}" Text="DOCUMENTS\XML"/>
            <TextBlock FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" Text="{Binding CorpusFolder}"/>
            <TextBlock Style="{StaticResource Caption}" Text="WORKING COPY"/>
            <TextBlock FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" Text="{Binding DocumentPath}"/>
            <WrapPanel Margin="0,12,0,0">
              <Button Content="Open export folder" Command="{Binding OpenExportFolderCommand}" Style="{StaticResource PrimaryButton}"/>
              <Button Content="Seed demo files" Command="{Binding SeedDemoCommand}"/>
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
