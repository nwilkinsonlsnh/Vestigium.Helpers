<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataTemplate x:Key="AnalyzeTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="8">
        <TextBlock Opacity="0.7" TextWrapping="Wrap"
                   Text="Share or folder must already be reachable from this process. The library will not net use or mount. Example: \\\\truenas\\sandbox"/>
        <TextBlock Margin="0,12,0,4" Text="Share or directory"/>
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Content="Demo folder" Command="{Binding UseDemoFolderCommand}" Margin="8,0,0,0"/>
          <Button DockPanel.Dock="Right" Content="Analyze sizes" Command="{Binding AnalyzeDemoFolderCommand}" Margin="8,0,0,0"/>
          <TextBox Text="{Binding AnalyzePath, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <TextBlock Margin="0,12,0,4" Text="Planned write size (caller value + unit)"/>
        <StackPanel Orientation="Horizontal">
          <TextBox Width="100" Text="{Binding AnalyzeSizeValue, UpdateSourceTrigger=PropertyChanged}"/>
          <ComboBox Width="80" Margin="8,0,0,0" ItemsSource="{Binding SizeUnits}" SelectedItem="{Binding AnalyzeSizeUnit}"/>
          <Button Content="Normalize" Command="{Binding NormalizeSizeDemoCommand}" Margin="8,0,0,0"/>
          <Button Content="Probe write + estimate" Command="{Binding WriteProbeDemoCommand}" Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock Margin="0,8,0,0" FontFamily="Cascadia Mono, Consolas" Text="{Binding AnalyzeNormalized}"/>
        <TextBlock Margin="0,8,0,0" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" Foreground="#7DD3FC" Text="{Binding AnalyzeEstimate}"/>
        <TextBlock Margin="0,8,0,8" Opacity="0.85" Text="{Binding AnalyzeSummary}" TextWrapping="Wrap"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ListView ItemsSource="{Binding AnalyzeRows}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Metric" DisplayMemberBinding="{Binding Metric}" Width="120"/>
                <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}" Width="280"/>
              </GridView>
            </ListView.View>
          </ListView>
          <ListView Grid.Column="2" ItemsSource="{Binding AnalyzeBuckets}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Bucket" DisplayMemberBinding="{Binding Metric}" Width="80"/>
                <GridViewColumn Header="Census" DisplayMemberBinding="{Binding Value}" Width="320"/>
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
