<Window x:Class="Vestigium.Helpers.FileIo.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vestigium.Helpers.FileIo gallery"
        Height="820" Width="1180"
        MinHeight="600" MinWidth="880"
        Background="#0B1A30" Foreground="#E2E8F0"
        FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="20,16,20,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel LastChildFill="False" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#7DD3FC" Text="VESTIGIUM SUITE"/>
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Vestigium.Helpers.FileIo gallery"/>
        <TextBlock Opacity="0.7" Text="Recon · buckets · AnalyzeDirectory · size units · probe write · Analytics"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
        <TextBlock Opacity="0.9" FontFamily="Cascadia Mono, Consolas" FontSize="16" Text="{Binding WrittenCaption}" HorizontalAlignment="Right"/>
        <TextBlock Opacity="0.55" FontFamily="Cascadia Mono, Consolas" Text="APPID FileIo · recon + buckets · Analytics sizes/rates" HorizontalAlignment="Right"/>
      </StackPanel>
    </DockPanel>
    <TabControl Grid.Row="1">
      <TabItem Header="Overview"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource OverviewTab}"/></TabItem>
      <TabItem Header="Copy"><ContentControl Content="{Binding Copy}" ContentTemplate="{StaticResource JobTab}"/></TabItem>
      <TabItem Header="Move"><ContentControl Content="{Binding Move}" ContentTemplate="{StaticResource JobTab}"/></TabItem>
      <TabItem Header="Delete"><ContentControl Content="{Binding Delete}" ContentTemplate="{StaticResource JobTab}"/></TabItem>
      <TabItem Header="Mirror"><ContentControl Content="{Binding Mirror}" ContentTemplate="{StaticResource JobTab}"/></TabItem>
      <TabItem Header="Audit Mode"><ContentControl Content="{Binding Audit}" ContentTemplate="{StaticResource JobTab}"/></TabItem>
      <TabItem Header="Analyze"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource AnalyzeTab}"/></TabItem>
      <TabItem Header="UniqueName"><ContentControl Content="{Binding Unique}" ContentTemplate="{StaticResource UniqueNameTab}"/></TabItem>
      <TabItem Header="Compare"><ContentControl Content="{Binding Compare}" ContentTemplate="{StaticResource CompareTab}"/></TabItem>
      <TabItem Header="Index"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource IndexTab}"/></TabItem>
      <TabItem Header="Stats"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatsTab}"/></TabItem>
      <TabItem Header="JSONL"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource JsonlTab}"/></TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock Opacity="0.55" Text="{Binding StatusText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</Window>
